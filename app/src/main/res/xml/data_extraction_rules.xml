<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12 and newer. Everything is backed up and transferred except the stored sign-in session,
   whose key cannot leave this device anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cinestream_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cinestream_session.xml" />
    </device-transfer>
</data-extraction-rules>
